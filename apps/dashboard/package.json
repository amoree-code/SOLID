{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "format": "biome format --write .",
    "test": "tsr generate && vitest run",
    "test:watch": "tsr generate && vitest",
    "test:coverage": "tsr generate && vitest run --coverage",
    "knip": "knip",
    "size": "size-limit",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "new:page": "node scripts/new-page.mjs",
    "verify": "pnpm typecheck && pnpm lint:ci && pnpm test && pnpm build && pnpm knip && pnpm size && pnpm e2e"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tabler/icons-react": "^3.47.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/zod-adapter": "^1.167.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-app": "^14.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "1.167.38",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "size-limit": "^14.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
