# Required: runtime database connection. A direct Supabase URL works for the simple setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solid_backend?schema=public"
# Optional: direct URL for Prisma migrations when DATABASE_URL uses Supabase pooler.
# Leave empty to let Prisma CLI reuse DATABASE_URL.
DIRECT_URL=
NODE_ENV=development
POSTGRES_PORT=5432
PORT=3000
# Comma-separated browser origins allowed to call this API, e.g. "http://localhost:5173".
# Empty = CORS disabled (server-to-server and same-origin calls still work).
CORS_ORIGIN=
# Rate limit per client: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS (defaults 100 / 60000).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Set false in production unless /docs is intentionally public.
SWAGGER_ENABLED=true
# Number of trusted reverse-proxy hops. Keep 0 for direct exposure.
TRUST_PROXY=0
