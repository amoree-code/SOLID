# Matches the Postgres in docker-compose.yml. If you change POSTGRES_PORT, change the port here too.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solid_backend?schema=public"
POSTGRES_PORT=5432
PORT=3000
# Comma-separated browser origins allowed to call this API. Leave empty to disable CORS.
CORS_ORIGIN="http://localhost:5173"
# Rate limit per client: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS (defaults 100 / 60000).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
