// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Reference resource — the pattern `pnpm new:resource` copies. Replace or
/// delete it once the project has its own models.
model ExampleResource {
  id        String                @id @default(cuid())
  name      String
  status    ExampleResourceStatus @default(active)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("example_resources")
}

enum ExampleResourceStatus {
  active
  inactive
}
